<policies>
  <inbound>
    <base />
    <cors allow-credentials="false">
      <allowed-origins>
        <origin>{{frontend-origin}}</origin>
      </allowed-origins>
      <allowed-methods preflight-result-max-age="300"><method>GET</method><method>OPTIONS</method></allowed-methods>
      <allowed-headers><header>authorization</header><header>ocp-apim-subscription-key</header><header>content-type</header></allowed-headers>
    </cors>
    <validate-jwt header-name="Authorization" require-scheme="Bearer" failed-validation-httpcode="401" failed-validation-error-message="A valid Entra access token is required.">
      <openid-config url="https://login.microsoftonline.com/{{entra-tenant-id}}/v2.0/.well-known/openid-configuration" />
      <audiences><audience>{{entra-api-audience}}</audience></audiences>
      <issuers><issuer>https://login.microsoftonline.com/{{entra-tenant-id}}/v2.0</issuer></issuers>
      <required-claims><claim name="scp" separator=" "><value>access_as_user</value></claim></required-claims>
    </validate-jwt>
    <set-header name="X-Gateway-Key" exists-action="override"><value>{{backend-shared-key}}</value></set-header>
    <set-header name="X-Authenticated-User" exists-action="override"><value>@(context.Principal?.Claims.GetValueOrDefault("oid", "") ?? "")</value></set-header>
    <set-header name="X-Authenticated-Name" exists-action="override"><value>@(context.Principal?.Claims.GetValueOrDefault("name", "") ?? "")</value></set-header>
    <set-backend-service base-url="https://{{backend-host}}" />
    <rewrite-uri template="/api/v1/hello" />
  </inbound>
  <backend><base /></backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
